<ui:FluentWindow
    x:Class="WinBgScheduler.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:v="clr-namespace:WinBgScheduler.App.Views"
    xmlns:vm="clr-namespace:WinBgScheduler.App.ViewModels"
    Title="Win BG Scheduler"
    Width="1200"
    Height="820"
    MinWidth="960"
    MinHeight="620"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    mc:Ignorable="d"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:SchedulesViewModel}">
            <v:SchedulesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScheduleEditorViewModel}">
            <v:ScheduleEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpcomingViewModel}">
            <v:UpcomingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DefaultsViewModel}">
            <v:DefaultsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ContentEditorViewModel}">
            <v:ContentEditorView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Win BG Scheduler" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="12,4,8,12">
                <ui:Card DockPanel.Dock="Bottom" Padding="12">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Scheduler.CurrentText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Caption}"
                            Text="{Binding Scheduler.NextText}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource Caption}"
                            Text="{Binding Scheduler.ErrorText}"
                            Visibility="{Binding Scheduler.ErrorText, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </ui:Card>

                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding NavItems}"
                    SelectedItem="{Binding SelectedNav}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6" Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="20" Symbol="{Binding Icon}" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ContentControl
                Grid.Column="1"
                Margin="16,4,24,16"
                Content="{Binding Navigator.Current}"
                Focusable="False" />
        </Grid>
    </Grid>
</ui:FluentWindow>
