<UserControl
    x:Class="WinBgScheduler.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinBgScheduler.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:CardControl}}" TargetType="ui:CardControl">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,16"
                Style="{StaticResource PageTitle}"
                Text="Configurações" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Inicialização" />
            <ui:CardControl
                Header="Instalar no computador (menu Iniciar, inicia com o Windows, fica na bandeja)"
                Icon="{ui:SymbolIcon ArrowDownload24}"
                Visibility="{Binding CanInstall, Converter={StaticResource VisibleWhen}}">
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding InstallCommand}"
                    Content="Instalar" />
            </ui:CardControl>
            <ui:CardControl Header="Iniciar com o Windows" Icon="{ui:SymbolIcon Power24}">
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
            </ui:CardControl>
            <ui:CardControl Header="Ao iniciar com o Windows, ficar só na bandeja" Icon="{ui:SymbolIcon Navigation24}">
                <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" />
            </ui:CardControl>

            <TextBlock
                Margin="0,16,0,10"
                Style="{StaticResource SectionTitle}"
                Text="Notificações" />
            <ui:CardControl Header="Avisar antes de trocar o papel de parede" Icon="{ui:SymbolIcon Alert24}">
                <ui:ToggleSwitch IsChecked="{Binding NotificationsEnabled}" />
            </ui:CardControl>
            <ui:CardControl Header="Aviso padrão para novos agendamentos (minutos)" Icon="{ui:SymbolIcon Timer24}">
                <ui:NumberBox
                    Width="130"
                    Maximum="1440"
                    Minimum="0"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding DefaultNotifyMinutes, Converter={StaticResource IntToDouble}}" />
            </ui:CardControl>

            <TextBlock
                Margin="0,16,0,10"
                Style="{StaticResource SectionTitle}"
                Text="Agendamentos" />
            <ui:Card Margin="0,0,0,8" Padding="16">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10" Text="{Binding PauseText}" />
                    <WrapPanel Visibility="{Binding IsPaused, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding PauseCommand}"
                            CommandParameter="60"
                            Content="Pausar 1 hora"
                            Icon="{ui:SymbolIcon Pause24}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding PauseCommand}"
                            CommandParameter="tomorrow"
                            Content="Pausar até amanhã" />
                        <ui:Button Command="{Binding PauseCommand}" Content="Pausar até eu retomar" />
                    </WrapPanel>
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ResumeCommand}"
                        Content="Retomar agora"
                        Icon="{ui:SymbolIcon Play24}"
                        Visibility="{Binding IsPaused, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </ui:Card>
            <ui:CardControl Header="Reaplicar o papel de parede agora" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:Button Command="{Binding ReapplyCommand}" Content="Reaplicar" />
            </ui:CardControl>

            <TextBlock
                Margin="0,16,0,10"
                Style="{StaticResource SectionTitle}"
                Text="Aparência" />
            <ui:CardControl Header="Tema" Icon="{ui:SymbolIcon DesktopPulse24}">
                <ComboBox
                    MinWidth="180"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedValue="{Binding Theme}"
                    SelectedValuePath="Value" />
            </ui:CardControl>

            <TextBlock
                Margin="0,16,0,10"
                Style="{StaticResource SectionTitle}"
                Text="Dados" />
            <ui:CardControl Header="Pasta de configuração" Icon="{ui:SymbolIcon FolderOpen24}">
                <ui:Button Command="{Binding OpenDataFolderCommand}" Content="Abrir" />
            </ui:CardControl>
            <ui:CardControl Header="Limpar cache de imagens geradas" Icon="{ui:SymbolIcon Delete24}">
                <ui:Button Command="{Binding ClearCacheCommand}" Content="Limpar" />
            </ui:CardControl>

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource Caption}"
                Text="{Binding Version, StringFormat=Win BG Scheduler {0}}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding DataFolder}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
