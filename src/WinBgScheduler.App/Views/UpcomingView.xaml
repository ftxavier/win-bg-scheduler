<UserControl
    x:Class="WinBgScheduler.App.Views.UpcomingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinBgScheduler.App.ViewModels"
    x:Name="Root"
    d:DataContext="{d:DesignInstance vm:UpcomingViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:UpcomingItem}">
            <ui:Card Margin="0,0,0,8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{Binding Time}" />
                    <Border
                        Grid.Column="1"
                        Width="96"
                        Height="54"
                        Background="#20000000"
                        CornerRadius="4">
                        <Image Source="{Binding Image, Converter={StaticResource PathToImage}, ConverterParameter=192}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel
                        Grid.Column="2"
                        Margin="14,0"
                        VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Monitors}" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Appearance="Transparent"
                        Command="{Binding DataContext.SkipCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        Content="Pular"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="Pular esta ocorrência"
                        Visibility="{Binding CanSkip, Converter={StaticResource VisibleWhen}}" />
                </Grid>
            </ui:Card>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <ui:Button
                Command="{Binding RefreshCommand}"
                Content="Atualizar"
                DockPanel.Dock="Right"
                Icon="{ui:SymbolIcon ArrowSync24}" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Próximas trocas" />
                <TextBlock Style="{StaticResource Caption}" Text="O que vai aparecer na sua área de trabalho nos próximos 7 dias, já considerando conflitos e exceções." />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Agora" />
                <ItemsControl ItemTemplate="{StaticResource ItemTemplate}" ItemsSource="{Binding Now}" />

                <TextBlock
                    Margin="0,16,0,0"
                    Style="{StaticResource Caption}"
                    Text="Nenhuma troca programada para os próximos 7 dias."
                    Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />

                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UpcomingDay}">
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Header}" />
                                <ItemsControl ItemTemplate="{StaticResource ItemTemplate}" ItemsSource="{Binding Items}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
