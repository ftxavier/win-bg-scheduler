<UserControl
    x:Class="WinBgScheduler.App.Views.SchedulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinBgScheduler.App.ViewModels"
    x:Name="Root"
    d:DataContext="{d:DesignInstance vm:SchedulesViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <ui:Button
                Appearance="Primary"
                Command="{Binding NewCommand}"
                Content="Novo agendamento"
                DockPanel.Dock="Right"
                Icon="{ui:SymbolIcon Add24}" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Agendamentos" />
                <TextBlock Style="{StaticResource Caption}" Text="Quando vários agendamentos coincidem, vence o mais específico: data única → anual → mensal → semanal → diário → período." />
            </StackPanel>
        </DockPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,60,0,0"
            HorizontalAlignment="Center"
            Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
            <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Symbol="CalendarClock24" />
            <TextBlock
                Margin="0,12,0,4"
                HorizontalAlignment="Center"
                FontSize="18"
                Text="Nenhum agendamento ainda" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource Caption}"
                Text="Crie um agendamento para trocar o papel de parede em dias e horários específicos." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScheduleItemViewModel}">
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="128"
                                    Height="72"
                                    Background="#20000000"
                                    CornerRadius="6">
                                    <Border.Clip>
                                        <RectangleGeometry
                                            RadiusX="6"
                                            RadiusY="6"
                                            Rect="0,0,128,72" />
                                    </Border.Clip>
                                    <Image Source="{Binding Thumbnail, Converter={StaticResource PathToImage}, ConverterParameter=256}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="16,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource Caption}"
                                        Text="{Binding Summary}" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            Margin="0,0,6,0"
                                            Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                            Visibility="{Binding IsActiveNow, Converter={StaticResource VisibleWhen}}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding NextText}" />
                                    </StackPanel>
                                </StackPanel>

                                <ui:ToggleSwitch
                                    Grid.Column="2"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Ativar / desativar"
                                    IsChecked="{Binding IsEnabled}"
                                    ToolTip="Ativar / desativar" />

                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.EditCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Editar"
                                        Icon="{ui:SymbolIcon Edit24}"
                                        ToolTip="Editar" />
                                    <ui:Button
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.DuplicateCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Duplicar"
                                        Icon="{ui:SymbolIcon Copy24}"
                                        ToolTip="Duplicar" />
                                    <ui:Button
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Excluir"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        ToolTip="Excluir" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
