<UserControl
    x:Class="WinBgScheduler.App.Views.ContentEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinBgScheduler.App.ViewModels"
    x:Name="Root"
    d:DataContext="{d:DesignInstance vm:ContentEditorViewModel}"
    mc:Ignorable="d">
    <StackPanel>
        <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowTargets, Converter={StaticResource VisibleWhen}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Label}" Text="Aplicar em" />
                <ComboBox
                    DisplayMemberPath="DisplayLabel"
                    ItemsSource="{Binding Targets}"
                    SelectedItem="{Binding SelectedTarget}" />
            </DockPanel>
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource Caption}"
                Text="Monitores sem imagens próprias usam as de &quot;Todos os monitores&quot;. • indica monitor com imagens definidas." />
        </StackPanel>

        <WrapPanel Margin="0,0,0,8">
            <ui:Button
                Margin="0,0,8,0"
                Command="{Binding AddFilesCommand}"
                Content="Adicionar imagens"
                Icon="{ui:SymbolIcon ImageAdd24}" />
            <ui:Button
                Margin="0,0,8,0"
                Command="{Binding AddFolderCommand}"
                Content="Adicionar pasta"
                Icon="{ui:SymbolIcon FolderAdd24}" />
            <ui:Button
                Appearance="Transparent"
                Command="{Binding ClearEntriesCommand}"
                Content="Limpar"
                Icon="{ui:SymbolIcon Dismiss24}" />
        </WrapPanel>

        <Grid>
            <ListBox
                x:Name="EntryList"
                MinHeight="96"
                MaxHeight="240"
                AllowDrop="True"
                DragOver="OnDragOver"
                Drop="OnDrop"
                ItemsSource="{Binding Entries}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedEntry}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ContentEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="64"
                                Height="36"
                                Background="#20000000"
                                CornerRadius="3">
                                <Grid>
                                    <Image Source="{Binding Path, Converter={StaticResource PathToImage}, ConverterParameter=128}" Stretch="UniformToFill" />
                                    <ui:SymbolIcon
                                        FontSize="20"
                                        Symbol="Folder24"
                                        Visibility="{Binding IsFolder, Converter={StaticResource VisibleWhen}}" />
                                </Grid>
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource Caption}"
                                    Text="{Binding Path}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="2"
                                Appearance="Transparent"
                                Command="{Binding DataContext.RemoveEntryCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Remover"
                                Icon="{ui:SymbolIcon Delete24}"
                                ToolTip="Remover" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Style="{StaticResource Caption}"
                Text="Arraste imagens ou pastas para cá"
                Visibility="{Binding Entries.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
        </Grid>

        <TextBlock
            Margin="0,6,0,12"
            Style="{StaticResource Caption}"
            Text="{Binding FilesSummary}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Ajuste" />
            <ComboBox
                Grid.Column="1"
                DisplayMemberPath="Label"
                ItemsSource="{Binding FitOptions}"
                SelectedValue="{Binding Fit}"
                SelectedValuePath="Value" />
            <CheckBox
                Grid.Column="2"
                Margin="12,0,0,0"
                Content="Incluir subpastas"
                IsChecked="{Binding IncludeSubfolders}" />
        </Grid>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding CanRotate, Converter={StaticResource VisibleWhen}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="Trocar de imagem a cada" />
                <ui:NumberBox
                    Width="130"
                    Maximum="10080"
                    Minimum="0"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding RotationMinutes, Converter={StaticResource IntToDouble}, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="8,0,0,0"
                    Style="{StaticResource Label}"
                    Text="minutos" />
            </StackPanel>
            <TextBlock
                Margin="0,4,0,10"
                Style="{StaticResource Caption}"
                Text="0 = sem rotação (mostra só a primeira imagem)." />
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="Ordem" />
                <ComboBox
                    MinWidth="160"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding OrderOptions}"
                    SelectedValue="{Binding Order}"
                    SelectedValuePath="Value" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
