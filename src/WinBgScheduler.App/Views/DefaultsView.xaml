<UserControl
    x:Class="WinBgScheduler.App.Views.DefaultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:WinBgScheduler.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinBgScheduler.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:DefaultsViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding ReloadCommand}"
                    Content="Desfazer"
                    IsEnabled="{Binding IsDirty}" />
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding SaveCommand}"
                    Content="Salvar"
                    Icon="{ui:SymbolIcon Save24}"
                    IsEnabled="{Binding IsDirty}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Papel padrão" />
                <TextBlock Style="{StaticResource Caption}" Text="Mostrado sempre que nenhum agendamento estiver ativo. Também pode ser uma pasta em rotação." />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
                <ui:Card VerticalAlignment="Top" Style="{StaticResource CardSpacing}">
                    <ContentControl Content="{Binding Content}" Focusable="False" />
                </ui:Card>
            </ScrollViewer>
            <ui:Card
                Grid.Column="1"
                VerticalAlignment="Top"
                Style="{StaticResource CardSpacing}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Pré-visualização" />
                    <c:WallpaperPreview
                        Fit="{Binding Content.Fit}"
                        ImagePath="{Binding Content.PreviewPath}"
                        MonitorHeight="{Binding Content.PreviewMonitorHeight}"
                        MonitorWidth="{Binding Content.PreviewMonitorWidth}" />
                    <ui:Button
                        Margin="0,12,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding TestCommand}"
                        Content="Testar no desktop por 10 segundos"
                        Icon="{ui:SymbolIcon Desktop24}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
